+};
+
+void macdrv_client_surface_presented(const macdrv_event *event)
+{
+    struct client_surface *client = event->client_surface_presented.client_surface;
+    HWND hwnd = macdrv_get_window_hwnd(event->window);
+    struct macdrv_win_data *data;
+    BOOL known = FALSE;
+
+    TRACE("client_surface %p hwnd %p\n", client, hwnd);
+
+    /* The layer posted a raw pointer; present it only while its window still holds it. */
+    if (!hwnd || !(data = get_win_data(hwnd))) return;
+    if (data->d3dmetal_client_surfaces)
+    {
+        CFRange all = CFRangeMake(0, CFArrayGetCount(data->d3dmetal_client_surfaces));
+        /* address arithmetic only: impl_from_client_surface() would read a possibly freed surface */
+        known = CFArrayContainsValue(data->d3dmetal_client_surfaces, all,
+                                     CONTAINING_RECORD(client, struct macdrv_client_surface, client));
+    }
+    if (known) client_surface_add_ref(client);
+    release_win_data(data);
+    if (!known)
+    {
+        WARN("client_surface %p no longer belongs to hwnd %p\n", client, hwnd);
+        return;
+    }
+
+    client_surface_present(client);
+    client_surface_release(client);
+}
+
+static void cf_client_surface_release(CFAllocatorRef allocator, const void *client_surface)
+{
+    client_surface_release((struct client_surface *)client_surface);
+}
+
+#endif

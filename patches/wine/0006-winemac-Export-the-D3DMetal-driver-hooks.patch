From: Mahdi Taziki <61482609+Mhd-tz@users.noreply.github.com>
Subject: [PATCH] winemac: Export the driver hooks D3DMetal uses.

Adds the macdrv_functions table (24 pointers, 192 bytes) and the 120-byte legacy window data D3DMetal (Apple's
Game Porting Toolkit) expects from winemac.so, the registry callbacks it needs (PE side, Unix init, WoW64 thunk),
the WineMetalLayer subclass that reports presented drawables, and the CLIENT_SURFACE_PRESENTED event.

Provenance (recorded by AnvilMac, 2026-10-17):
  Original: CodeWeavers' CrossOver 26.3.0 source (https://www.codeweavers.com/crossover/source), Wine 11.0 base,
            "CW HACK 22435" in dlls/winemac.drv: d3dmetal.c, d3dmetal_objc.m, d3dmetal_objc.h (Brendan Shanks for
            CodeWeavers, 2023/2025) and the matching hooks in Makefile.in, macdrv.h, macdrv_cocoa.h, cocoa_window.m,
            window.c, event.c, macdrv_main.c, unixlib.h, dllmain.c. License: LGPL-2.1-or-later (Wine).
  Adapted to wine-11.19 + anvilmac-runtime patches 0001-0005 (AnvilMac):
            - Wine 11.19's typed Cocoa handles (WineWindow *, WineContentView *, WineMetalView *, MTLDevice_id,
              CAMetalLayer *) in place of the removed macdrv_window/view/metal_* typedefs; same pointer sizes, so the
              table and window data keep their layout (C_ASSERTs kept);
            - macdrv_CreateClientSurface(hwnd, 0, FALSE) + impl_from_client_surface() in place of
              macdrv_client_surface_create(hwnd), as in patch 0002;
            - the Unix-side RegCloseKey() helper renamed (11.19's headers declare RegCloseKey);
            - CLIENT_SURFACE_PRESENTED presents a surface only while its window still holds it (the layer posts a raw
              pointer; the donor presented it unchecked).
            Patch 0002's ExtEscape path for DXMT is unchanged.
  Not included: CrossOver's other ntdll changes for D3DMetal (CW HACK 22434, CX Hack 23015, the __wine_unix_call
            export): Apple's 4.0 beta 3 bridge creates Direct3D 11/12 devices and presents without them (AnvilMac's
            tests, 2026-10-18).
  Nothing from Apple is in this change or in the runtime: the user imports Apple's Game Porting Toolkit into AnvilMac,
  which loads it only for a game the user runs with D3DMetal.
---
diff --git a/dlls/winemac.drv/Makefile.in b/dlls/winemac.drv/Makefile.in
index 1eb2b9c..ecd15bf 100644
--- a/dlls/winemac.drv/Makefile.in
+++ b/dlls/winemac.drv/Makefile.in
@@ -1,7 +1,7 @@
 MODULE    = winemac.drv
 UNIXLIB   = winemac.so
 IMPORTS   = uuid rpcrt4 user32 gdi32 win32u
-DELAYIMPORTS = ole32 shell32 imm32
+DELAYIMPORTS = advapi32 ole32 shell32 imm32
 UNIX_LIBS    = \
 	-lwin32u \
 	-framework AppKit \
@@ -26,6 +26,8 @@ SOURCES = \
 	cocoa_opengl.m \
 	cocoa_status_item.m \
 	cocoa_window.m \
+	d3dmetal.c \
+	d3dmetal_objc.m \
 	display.c \
 	dllmain.c \
 	event.c \
diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index 94fc3e7..a4dad8e 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -31,6 +31,7 @@
 #import "cocoa_app.h"
 #import "cocoa_event.h"
 #import "cocoa_opengl.h"
+#import "d3dmetal_objc.h" /* D3DMetal hooks (CW HACK 22435) */
 
 #pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
 
@@ -243,6 +244,8 @@ @interface WineContentView : WineBaseView <NSTextInputClient, NSViewLayerContent
 
     WineMetalView *_metalView;
     NSMutableDictionary<NSNumber*, CALayerHost*>* _caLayerHosts;
+
+@public void *d3dmetal_client_surface; /* D3DMetal hooks (CW HACK 22435) */
 }
 
 @property (readonly, nonatomic) BOOL everHadGLContext;
@@ -849,7 +852,7 @@ - (void) setRetinaMode:(BOOL)mode
 
     - (CALayer*) makeBackingLayer
     {
-        CAMetalLayer *layer = [CAMetalLayer layer];
+        CAMetalLayer *layer = [WineMetalLayer layer]; /* D3DMetal hooks (CW HACK 22435) */
         layer.device = _device;
         layer.framebufferOnly = YES;
         layer.magnificationFilter = kCAFilterNearest;
@@ -3843,6 +3846,20 @@ void macdrv_set_view_backing_size(WineContentView *view, const int backing_size[
         [view wine_setBackingSize:backing_size];
 }
 
+/* D3DMetal hooks (CW HACK 22435) */
+void *macdrv_get_view_d3dmetal_client_surface(WineContentView *view)
+{
+    if ([view isKindOfClass:[WineContentView class]])
+        return view->d3dmetal_client_surface;
+    return NULL;
+}
+
+void macdrv_set_view_d3dmetal_client_surface(WineContentView *view, void *client_surface)
+{
+    if ([view isKindOfClass:[WineContentView class]])
+        view->d3dmetal_client_surface = client_surface;
+}
+

+/* A USB DualSense shown as an Xbox 360 controller: Wine's Xbox-style gamepad (XInput through winexinput),
+ * filled from the DualSense's reports, its rumble sent back to the DualSense. */
+static void create_dualsense_as_xbox(IOHIDDeviceRef IOHIDDevice, struct device_desc *desc)
+{
+    static const USAGE_AND_PAGE device_usage = {.UsagePage = HID_USAGE_PAGE_GENERIC, .Usage = HID_USAGE_GENERIC_GAMEPAD};
+    struct iohid_device *impl;
+    BOOL bluetooth = desc->bus_type == BUS_TYPE_BLUETOOTH;
+
+    desc->vid = 0x045e;
+    desc->pid = 0x028e;
+    desc->interface = 0;
+    desc->bus_type = BUS_TYPE_USB;
+    desc->bus_id = 0xff5d01; /* vendor class, subclass 0x5d, protocol 1: an Xbox 360 controller */
+    set_product(desc, "Controller (XBOX 360 For Windows)");
+    desc->is_gamepad = TRUE;
+    /* winebus.sys keeps a device only if this matches its hidraw preference for it */
+    desc->is_hidraw = options->disable_sdl && options->disable_input;
+
+    if (!(impl = hid_device_create(&dualsense_xbox_vtbl, sizeof(struct iohid_device)))) return;
+    list_add_tail(&device_list, &impl->unix_device.entry);
+    impl->device = IOHIDDevice;
+    impl->buffer = NULL;
+    impl->dualsense = DUALSENSE_AS_XBOX;
+    impl->dualsense_bluetooth = bluetooth;
+    if (!hid_device_begin_report_descriptor(&impl->unix_device, &device_usage) ||
+        !hid_device_add_gamepad(&impl->unix_device) ||
+        !hid_device_add_haptics(&impl->unix_device) ||
+        !hid_device_end_report_descriptor(&impl->unix_device))
+    {
+        list_remove(&impl->unix_device.entry);
+        impl->unix_device.vtbl->destroy(&impl->unix_device);
+        return;
+    }
+    hid_device_set_hatswitch_x(&impl->unix_device, 0, 0);
+    hid_device_set_hatswitch_y(&impl->unix_device, 0, 0);
+
+    bus_event_queue_device_created(&event_queue, &impl->unix_device, desc);
+}

+/* DualShock 4 USB report descriptor for a DualSense shown as one: input report 1 in the DualShock 4 layout
+ * (sticks, hat, 14 buttons, counter, triggers, then 54 bytes of sensors, status and touch) and output
+ * report 5 (rumble and light bar). */
+static const BYTE ds4_report_descriptor[] =
+{
+    0x05, 0x01, 0x09, 0x05, 0xa1, 0x01,             /* Generic Desktop, Game Pad, Collection (Application) */
+    0x85, 0x01,                                     /*   Report ID (1) */
+    0x09, 0x30, 0x09, 0x31, 0x09, 0x32, 0x09, 0x35, /*   X, Y, Z, Rz: the sticks */
+    0x15, 0x00, 0x26, 0xff, 0x00, 0x75, 0x08, 0x95, 0x04, 0x81, 0x02,
+    0x09, 0x39, 0x15, 0x00, 0x25, 0x07, 0x35, 0x00, 0x46, 0x3b, 0x01, 0x65, 0x14, /* Hat switch */
+    0x75, 0x04, 0x95, 0x01, 0x81, 0x42, 0x65, 0x00,
+    0x05, 0x09, 0x19, 0x01, 0x29, 0x0e, 0x15, 0x00, 0x25, 0x01, 0x75, 0x01, 0x95, 0x0e, 0x81, 0x02, /* Buttons 1-14 */
+    0x06, 0x00, 0xff, 0x09, 0x20, 0x75, 0x06, 0x95, 0x01, 0x15, 0x00, 0x25, 0x3f, 0x81, 0x02, /* Report counter */
+    0x05, 0x01, 0x09, 0x33, 0x09, 0x34, 0x15, 0x00, 0x26, 0xff, 0x00, 0x75, 0x08, 0x95, 0x02, 0x81, 0x02, /* Triggers */
+    0x06, 0x00, 0xff, 0x09, 0x21, 0x95, 0x36, 0x81, 0x02, /* Sensors, status, touch */
+    0x85, 0x05, 0x09, 0x22, 0x95, 0x1f, 0x91, 0x02, /*   Report ID (5): output, 31 bytes */
+    0xc0,
+};
+
+static void set_product(struct device_desc *desc, const char *name)
+{
+    UINT i;
+
+    for (i = 0; name[i] && i < ARRAY_SIZE(desc->product) - 1; i++) desc->product[i] = name[i];
+    desc->product[i] = 0;
+}
+
+static enum dualsense_mode get_dualsense_mode(const struct device_desc *desc)
+{
+    const char *mode = getenv("WINEBUS_DUALSENSE");
+
+    if (desc->vid != 0x054c || desc->pid != 0x0ce6) return DUALSENSE_NATIVE;
+    if (desc->bus_type != BUS_TYPE_USB && desc->bus_type != BUS_TYPE_BLUETOOTH) return DUALSENSE_NATIVE;
+    TRACE("%s DualSense shown as %s\n", desc->bus_type == BUS_TYPE_USB ? "USB" : "Bluetooth",
+          mode && (!strcmp(mode, "ds4") || !strcmp(mode, "xbox")) ? mode : "itself");
+    if (mode && !strcmp(mode, "ds4")) return DUALSENSE_AS_DS4;
+    if (mode && !strcmp(mode, "xbox")) return DUALSENSE_AS_XBOX;
+    return DUALSENSE_NATIVE;
+}
+
+/* CRC-32 (zlib's) of a seed byte then data, as DualSense Bluetooth reports carry it. */
+static UINT dualsense_crc32(BYTE seed, const BYTE *data, UINT length)
+{
+    UINT crc = 0xffffffff, i, bit;
+
+    for (i = 0; i <= length; i++)
+    {
+        crc ^= i ? data[i - 1] : seed;
+        for (bit = 0; bit < 8; bit++) crc = (crc >> 1) ^ (0xedb88320 & -(crc & 1));
+    }
+    return ~crc;
+}
+
+/* Sends a DualSense output report: the rumble motors when rumble is set, the light bar when rgb is. Over USB
+ * report 2 holds the 47 common bytes; over Bluetooth report 0x31 holds a sequence, a tag, the same bytes and a
+ * CRC-32 over 0xa2 and the report. */
+static IOReturn dualsense_send_output(struct iohid_device *impl, BOOL rumble, BYTE strong, BYTE weak, const BYTE *rgb)
+{
+    BYTE common[47] = {0}, report[78] = {0};
+    UINT length, crc;
+
+    if (rumble)
+    {
+        common[0] = 0x03; /* compatible vibration, haptics select */
+        common[2] = weak; /* right motor */
+        common[3] = strong; /* left motor */
+    }
+    if (rgb)
+    {
+        common[1] = 0x04; /* light bar control */
+        memcpy(common + 44, rgb, 3);
+    }
+    if (impl->dualsense_bluetooth)
+    {
+        report[0] = 0x31;
+        report[1] = (impl->dualsense_output_seq++ & 0x0f) << 4;
+        report[2] = 0x10;
+        memcpy(report + 3, common, sizeof(common));
+        crc = dualsense_crc32(0xa2, report, 74);
+        report[74] = crc;
+        report[75] = crc >> 8;
+        report[76] = crc >> 16;
+        report[77] = crc >> 24;
+        length = 78;
+    }
+    else
+    {
+        report[0] = 0x02;
+        memcpy(report + 1, common, sizeof(common));
+        length = 48;
+    }
+    return IOHIDDeviceSetReport(impl->device, kIOHIDReportTypeOutput, report[0], report, length);
+}
+
+/* Requesting the calibration report (feature 5) makes a Bluetooth DualSense send its full input report 0x31,
+ * as for the DualShock 4; the shown-as modes read sensors and touch from it. */
+static void iohid_device_init_dualsense_bluetooth(struct iohid_device *impl)
+{
+    uint8_t report[64] = {0x05};
+    CFIndex length = sizeof(report);
+    IOReturn ret;
+
+    ret = IOHIDDeviceGetReport(impl->device, kIOHIDReportTypeFeature, report[0], report, &length);
+    if (ret != kIOReturnSuccess)
+        WARN("DualSense Bluetooth calibration request failed: %#x\n", (unsigned int)ret);
+    else
+        TRACE("DualSense Bluetooth calibration requested, length %ld\n", (long)length);
+}
+
+/* A DualSense input report in the USB layout (64 bytes): USB report 1 as it is, Bluetooth report 0x31 without
+ * its extra byte, or the short Bluetooth report 1 (sticks, buttons, triggers; no sensors) spread out. */
+static BOOL dualsense_usb_report(const uint8_t *report, CFIndex length, BYTE *usb)
+{
+    if (length >= 64 && report[0] == 0x01)
+    {
+        memcpy(usb, report, 64);
+        return TRUE;
+    }
+    memset(usb, 0, 64);
+    usb[0] = 0x01;
+    if (length >= 65 && report[0] == 0x31)
+    {
+        memcpy(usb + 1, report + 2, 63);
+        return TRUE;
+    }
+    if (length >= 10 && report[0] == 0x01)
+    {
+        memcpy(usb + 1, report + 1, 4); /* sticks */
+        memcpy(usb + 8, report + 5, 3); /* buttons */
+        usb[5] = report[8]; /* L2 */
+        usb[6] = report[9]; /* R2 */
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* Rewrites a DualSense USB input report as a DualShock 4 USB one: sticks, hat and buttons (Create acts as
+ * Share) keep their bits; triggers, sensors, battery and the first two touch points move to their places. */
+static void dualsense_to_ds4_report(struct iohid_device *impl, const BYTE *in, BYTE *out)
+{
+    UINT timestamp = (in[28] | (in[29] << 8) | (in[30] << 16) | ((UINT)in[31] << 24)) / 16; /* 0.33 to 5.33 us */
+    BYTE level = (in[53] & 0x0f) > 10 ? 10 : in[53] & 0x0f;
+
+    memset(out, 0, 64);
+    out[0] = 0x01;
+    memcpy(out + 1, in + 1, 4);
+    out[5] = in[8];
+    out[6] = in[9];
+    out[7] = (in[10] & 0x03) | (impl->ds4_counter++ << 2);
+    out[8] = in[5];
+    out[9] = in[6];
+    out[10] = timestamp;
+    out[11] = timestamp >> 8;
+    memcpy(out + 13, in + 16, 12);
+    out[30] = ((in[53] >> 4) == 2 ? 11 : level) | 0x10; /* full when charged; cable connected */
+    out[33] = 1;
+    out[34] = impl->ds4_counter;
+    memcpy(out + 35, in + 33, 8);
+}
+
+static void handle_dualsense_as_ds4_report(void *context, IOReturn result, void *sender, IOHIDReportType type,
+        uint32_t reportID, uint8_t *report, CFIndex report_length)
+{
+    struct unix_device *iface = (struct unix_device *)context;
+    BYTE usb[64], ds4[64];
+
+    if (!dualsense_usb_report(report, report_length, usb)) return;
+    dualsense_to_ds4_report(impl_from_unix_device(iface), usb, ds4);
+    bus_event_queue_input_report(&event_queue, iface, ds4, sizeof(ds4));
+}
+
+/* Fills Wine's Xbox-style gamepad report from a DualSense input report, as XUSB devices report it. */
+static void handle_dualsense_as_xbox_report(void *context, IOReturn result, void *sender, IOHIDReportType type,
+        uint32_t reportID, uint8_t *input, CFIndex report_length)
+{
+    struct unix_device *iface = (struct unix_device *)context;
+    struct iohid_device *impl = impl_from_unix_device(iface);
+    struct hid_device_state *state = &iface->hid_device_state;
+    BYTE report[64], now[9], hat, b0, b1;
+    BOOL up, right, down, left;
+    LONG value;
+    int i;
+
+    if (!dualsense_usb_report(input, report_length, report)) return;
+    memcpy(now, report + 1, 6); /* sticks and triggers */
+    memcpy(now + 6, report + 8, 3); /* buttons, without the report counter */
+    if (!memcmp(now, impl->dualsense_last, sizeof(now))) return;
+    memcpy(impl->dualsense_last, now, sizeof(now));
+
+    for (i = 0; i < 4; i++)
+    {
+        value = ((report[1 + i] << 8) | report[1 + i]) - 32768;
+        if (i & 1) value = -value - 1; /* up is positive */
+        hid_device_set_abs_axis(iface, i, value);
+    }
+    hid_device_set_abs_axis(iface, 4, report[5] * 32767 / 255);
+    hid_device_set_abs_axis(iface, 5, report[6] * 32767 / 255);
+
+    b0 = report[8];
+    b1 = report[9];
+    hat = b0 & 0x0f;
+    up = hat == 7 || hat == 0 || hat == 1;
+    right = hat >= 1 && hat <= 3;
+    down = hat >= 3 && hat <= 5;
+    left = hat >= 5 && hat <= 7;
+    hid_device_set_button(iface, 0, !!(b0 & 0x20)); /* A: Cross */
+    hid_device_set_button(iface, 1, !!(b0 & 0x40)); /* B: Circle */
+    hid_device_set_button(iface, 2, !!(b0 & 0x10)); /* X: Square */
+    hid_device_set_button(iface, 3, !!(b0 & 0x80)); /* Y: Triangle */
+    hid_device_set_button(iface, 4, !!(b1 & 0x01)); /* LB: L1 */
+    hid_device_set_button(iface, 5, !!(b1 & 0x02)); /* RB: R1 */
+    hid_device_set_button(iface, 6, !!(b1 & 0x10)); /* Back: Create */
+    hid_device_set_button(iface, 7, !!(b1 & 0x20)); /* Start: Options */
+    hid_device_set_button(iface, 8, !!(b1 & 0x40)); /* LS: L3 */
+    hid_device_set_button(iface, 9, !!(b1 & 0x80)); /* RS: R3 */
+    hid_device_set_button(iface, 10, up);
+    hid_device_set_button(iface, 11, right);
+    hid_device_set_button(iface, 12, down);
+    hid_device_set_button(iface, 13, left);
+    hid_device_set_hatswitch_x(iface, 0, right - left);
+    hid_device_set_hatswitch_y(iface, 0, down - up);
+    hid_device_set_button(iface, 16, !!(report[10] & 0x01)); /* Guide: PS */
+    bus_event_queue_input_report(&event_queue, iface, state->report_buf, state->report_len);
+}

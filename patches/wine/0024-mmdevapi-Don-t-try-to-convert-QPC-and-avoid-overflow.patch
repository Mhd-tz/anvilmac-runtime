Subject: mmdevapi: Don't try to convert QPC and avoid overflow.
Author: Paul Gofman (CodeWeavers), WineHQ commit 5a66c3e86945710eba479f35374e317de3bb853a (2026-10-29), applied verbatim.
Licence: LGPL-2.1-or-later, same as Wine.
Provenance: https://gitlab.winehq.org/wine/wine/-/commit/5a66c3e86945710eba479f35374e317de3bb853a (in wine-11.21). Applied after
0001-0023 to Wine 11.19, source tarball 73eb0b02dfc0cb0ff4f4d8d36c5786261e9725ac91968ae4d4e4b9a498c4087f. Not submitted upstream by AnvilMac (it is upstream).
Why (AnvilMac, 2026-11-12): the audio drivers returned the QPC position as QPC ticks * 10000000 / frequency; Wine's
QPC on macOS counts from boot including sleep, so after about 25.6 hours of uptime the product overflows 64 bits and
every game asking IAudioClock::GetPosition or IAudioCaptureClient for a QPC time got a wrong one. The owner's Mac had
been up 5 days 10 hours (2026-11-12). No game symptom tied to it yet.

From 5a66c3e86945710eba479f35374e317de3bb853a Mon Sep 17 00:00:00 2001
From: Paul Gofman <pgofman@codeweavers.com>
Date: Thu, 29 Oct 2026 18:02:57 -0600
Subject: [PATCH] mmdevapi: Don't try to convert QPC and avoid overflow.

Multiplication overflows with big enough system uptime,
while this conversion is not really needed.
---
 dlls/winealsa.drv/alsa.c           | 12 ++++++------
 dlls/winecoreaudio.drv/coreaudio.c | 12 ++++++------
 dlls/wineoss.drv/oss.c             | 12 ++++++------
 dlls/winepulse.drv/pulse.c         | 12 ++++++------
 4 files changed, 24 insertions(+), 24 deletions(-)

diff --git a/dlls/winealsa.drv/alsa.c b/dlls/winealsa.drv/alsa.c
index 4ad83bdba05..fb00809bee3 100644
--- a/dlls/winealsa.drv/alsa.c
+++ b/dlls/winealsa.drv/alsa.c
@@ -1808,9 +1808,9 @@ static NTSTATUS alsa_get_capture_buffer(void *args)
     if(params->devpos)
       *params->devpos = stream->written_frames;
     if(params->qpcpos){ /* fixme: qpc of recording time */
-        LARGE_INTEGER stamp, freq;
-        NtQueryPerformanceCounter(&stamp, &freq);
-        *params->qpcpos = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+        LARGE_INTEGER stamp;
+        NtQueryPerformanceCounter(&stamp, NULL);
+        *params->qpcpos = stamp.QuadPart;
     }
 
     return alsa_unlock_result(stream, &params->result, *frames ? S_OK : AUDCLNT_S_BUFFER_EMPTY);
@@ -2179,9 +2179,9 @@ static NTSTATUS alsa_get_position(void *args)
         *params->pos = position;
 
     if(params->qpctime){
-        LARGE_INTEGER stamp, freq;
-        NtQueryPerformanceCounter(&stamp, &freq);
-        *params->qpctime = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+        LARGE_INTEGER stamp;
+        NtQueryPerformanceCounter(&stamp, NULL);
+        *params->qpctime = stamp.QuadPart;
     }
 
     return alsa_unlock_result(stream, &params->result, S_OK);
diff --git a/dlls/winecoreaudio.drv/coreaudio.c b/dlls/winecoreaudio.drv/coreaudio.c
index 91ac62f54d4..163faff8bb8 100644
--- a/dlls/winecoreaudio.drv/coreaudio.c
+++ b/dlls/winecoreaudio.drv/coreaudio.c
@@ -1905,7 +1905,7 @@ static NTSTATUS unix_get_capture_buffer(void *args)
     struct get_capture_buffer_params *params = args;
     struct coreaudio_stream *stream = handle_get_stream(params->stream);
     UINT32 chunk_bytes, chunk_frames;
-    LARGE_INTEGER stamp, freq;
+    LARGE_INTEGER stamp;
     SIZE_T size;
 
     os_unfair_lock_lock(&stream->lock);
@@ -1946,8 +1946,8 @@ static NTSTATUS unix_get_capture_buffer(void *args)
     if(params->devpos)
         *params->devpos = stream->written_frames;
     if(params->qpcpos){ /* fixme: qpc of recording time */
-        NtQueryPerformanceCounter(&stamp, &freq);
-        *params->qpcpos = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+        NtQueryPerformanceCounter(&stamp, NULL);
+        *params->qpcpos = stamp.QuadPart;
     }
     params->result = S_OK;
 
@@ -2008,7 +2008,7 @@ static NTSTATUS unix_get_position(void *args)
 {
     struct get_position_params *params = args;
     struct coreaudio_stream *stream = handle_get_stream(params->stream);
-    LARGE_INTEGER stamp, freq;
+    LARGE_INTEGER stamp;
 
     if (params->device) {
         FIXME("Device position reporting not implemented\n");
@@ -2024,8 +2024,8 @@ static NTSTATUS unix_get_position(void *args)
         *params->pos *= stream->fmt->nBlockAlign;
 
     if(params->qpctime){
-        NtQueryPerformanceCounter(&stamp, &freq);
-        *params->qpctime = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+        NtQueryPerformanceCounter(&stamp, NULL);
+        *params->qpctime = stamp.QuadPart;
     }
 
     os_unfair_lock_unlock(&stream->lock);
diff --git a/dlls/wineoss.drv/oss.c b/dlls/wineoss.drv/oss.c
index 431264faf31..6682a0c09e2 100644
--- a/dlls/wineoss.drv/oss.c
+++ b/dlls/wineoss.drv/oss.c
@@ -1068,9 +1068,9 @@ static NTSTATUS oss_get_capture_buffer(void *args)
     if(devpos)
        *devpos = stream->written_frames;
     if(qpcpos){
-        LARGE_INTEGER stamp, freq;
-        NtQueryPerformanceCounter(&stamp, &freq);
-        *qpcpos = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+        LARGE_INTEGER stamp;
+        NtQueryPerformanceCounter(&stamp, NULL);
+        *qpcpos = stamp.QuadPart;
     }
 
     return oss_unlock_result(stream, &params->result, *frames ? S_OK : AUDCLNT_S_BUFFER_EMPTY);
@@ -1344,9 +1344,9 @@ static NTSTATUS oss_get_position(void *args)
         *pos *= stream->fmt->nBlockAlign;
 
     if(qpctime){
-        LARGE_INTEGER stamp, freq;
-        NtQueryPerformanceCounter(&stamp, &freq);
-        *qpctime = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+        LARGE_INTEGER stamp;
+        NtQueryPerformanceCounter(&stamp, NULL);
+        *qpctime = stamp.QuadPart;
     }
 
     return oss_unlock_result(stream, &params->result, S_OK);
diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index ef13a1ed0bb..0539a4601be 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -1492,7 +1492,7 @@ static void pulse_read(struct pulse_stream *stream)
 
         if (stream->started)
         {
-            LARGE_INTEGER stamp, freq;
+            LARGE_INTEGER stamp;
             ACPacket *p, *next;
 
             if (!(p = (ACPacket*)list_head(&stream->packet_free_head)))
@@ -1509,8 +1509,8 @@ static void pulse_read(struct pulse_stream *stream)
             {
                 stream->held_bytes += stream->period_bytes;
             }
-            NtQueryPerformanceCounter(&stamp, &freq);
-            p->qpcpos = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+            NtQueryPerformanceCounter(&stamp, NULL);
+            p->qpcpos = stamp.QuadPart;
             p->discont = 0;
             list_remove(&p->entry);
             list_add_tail(&stream->packet_filled_head, &p->entry);
@@ -2334,9 +2334,9 @@ static NTSTATUS pulse_get_position(void *args)
 
     if (params->qpctime)
     {
-        LARGE_INTEGER stamp, freq;
-        NtQueryPerformanceCounter(&stamp, &freq);
-        *params->qpctime = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+        LARGE_INTEGER stamp;
+        NtQueryPerformanceCounter(&stamp, NULL);
+        *params->qpctime = stamp.QuadPart;
     }
 
     params->result = S_OK;

From: Mahdi Taziki <61482609+Mhd-tz@users.noreply.github.com>
Subject: [PATCH] ntdll: Keep the old macOS %gs model in D3DMetal processes.

Apple's D3DMetal 4.0 bridge (libd3dshared.dylib) runs macOS code called straight from PE code. Since April 2025
(upstream 3a16aabb "On macOS x86_64, swap GSBASE between the TEB and macOS TSD when entering/leaving PE code" and
90a9078e "Remove x86_64 Mac-specific TEB access workarounds"), Wine points %gs at the TEB while PE code runs, so the
bridge's pthread calls read the TEB as macOS thread data and crash (a NULL read in libsystem_pthread). CrossOver
26.3.0 (Wine 11.0) keeps the earlier model, which is why 4.0b3 runs there.

When WINE_D3DMETAL_LIBD3DSHARED or an absolute WINE_D3DMETAL_DLLPATH is set (AnvilMac sets them only for a D3DMetal
setup), the process keeps %gs on the macOS thread data (TSD) and never switches it to the TEB; the TEB's Self and
ThreadLocalStoragePointer are mirrored into the TSD at the TEB offsets (0x30, 0x58), and the PE loader keeps the
mirrored TLS pointer current through TEB.Instrumentation[0]. Every other process is unchanged:
  - the four switches to the TEB (leave_handler, call_user_mode_callback, the syscall and unix call dispatcher exits)
    are skipped only in such a process; check_invalid_gsbase does nothing there;
  - %gs-relative reads that assumed %gs = TEB (three dispatcher entries %gs:0x378, the instrumentation callback
    %gs:0x330, and the PE ntdll's %gs:0x60 PEB reads) go through TEB.Self (%gs:0x30) instead, which is valid in both
    models; when %gs is invalid the same labelled instruction still faults first, so upstream's fixup still applies.
Unlike Wine 11.0/CrossOver, the PEB is NOT mirrored into TSD slot 12 (%gs:0x60): on macOS 27 that slot is in use, and
a PEB pointer stored there had macOS write into PEB+0x20 (ProcessParameters), crashing every process (found
2026-10-18). Nothing in Wine reads %gs:0x60 any more.

Provenance (recorded by AnvilMac, 2026-10-18): the mirrored-TEB model and the PE loader's TLS mirroring are restored
from Wine before upstream 3a16aabb/90a9078e (as kept in CodeWeavers' CrossOver 26.3.0 source), adapted to wine-11.19
+ patches 0001-0007, with the per-process gate and the slot-12 change above.
Changes copyright 2026 Mahdi Taziki. License: LGPL-2.1-or-later (Wine).
---
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -73,6 +73,19 @@
  * Note that the dispatchers do the syscall directly to avoid using the stack.
  */
 extern void _thread_set_tsd_base(uint64_t);
+/* D3DMetal bridge: Wine 11.0's macOS %gs model in D3DMetal processes (AnvilMac, patch 0009) */
+/* Apple's D3DMetal 4.0 bridge (libd3dshared) runs macOS code called straight from PE code, which needs %gs to be the
+ * macOS thread data (TSD) as in Wine 11.0. When the D3DMetal variables are set, %gs stays the TSD, with the TEB's
+ * Self and ThreadLocalStoragePointer mirrored into it at the TEB offsets; it is never switched to the TEB. */
+char macos_legacy_gs = 0;
+static void init_macos_legacy_gs(void)
+{
+    static int done;
+    const char *bridge = getenv( "WINE_D3DMETAL_LIBD3DSHARED" ), *dlls = getenv( "WINE_D3DMETAL_DLLPATH" );
+    if (done) return;
+    done = 1;
+    macos_legacy_gs = (bridge && *bridge) || (dlls && dlls[0] == '/');
+}
 #endif
 
 #include "ntstatus.h"
@@ -823,7 +836,8 @@
         if (fs32_sel) __asm__ volatile( "movw %0,%%fs" :: "r" (fs32_sel) );
     }
 #elif defined __APPLE__
-    if (!is_inside_signal_stack( data, (void *)RSP_sig(sigcontext )) &&
+    if (!macos_legacy_gs &&
+        !is_inside_signal_stack( data, (void *)RSP_sig(sigcontext )) &&
         !is_inside_syscall( data, RSP_sig(sigcontext )))
         _thread_set_tsd_base( (uint64_t)data->teb );
 #endif
@@ -1683,12 +1697,15 @@
                    "movw %ax,%fs\n"
                    "1:\n\t"
 #elif defined __APPLE__
+                   "cmpb $0," __ASM_NAME("macos_legacy_gs") "(%rip)\n\t"
+                   "jnz 7f\n\t"
                    "movq %rcx,%r10\n\t"
                    "movq %r13,%rdi\n\t"
                    "xorl %esi,%esi\n\t"
                    "movl $0x3000003,%eax\n\t"  /* _thread_set_tsd_base */
                    "syscall\n\t"
-                   "movq %r10,%rcx\n\t"
+                   "movq %r10,%rcx\n"
+                   "7:\n\t"
 #endif
                    "movq 0x330(%r13),%r10\n\t" /* amd64_thread_data()->instrumentation_callback */
                    "movq (%r10),%r10\n\t"
@@ -2190,6 +2207,9 @@
     ULONG_PTR cur_gsbase = 0;
 
     if (!data->teb) return FALSE;
+#ifdef __APPLE__
+    if (macos_legacy_gs) return FALSE;  /* D3DMetal bridge: Wine 11.0's macOS %gs model in D3DMetal processes (AnvilMac, patch 0009) */
+#endif
     if (CS_sig(ucontext) != cs64_sel) return FALSE;
     if (((ERROR_sig(ucontext) >> 1) & 0x09) == EXCEPTION_EXECUTE_FAULT) return FALSE;
 
@@ -2808,6 +2828,9 @@
     if (user_shared_data->XState.Size) xstate_size = user_shared_data->XState.Size - sizeof(XSAVE_FORMAT);
     frame_size = offsetof( struct syscall_frame, xstate ) + xstate_size;
     xstate_extended_features = user_shared_data->XState.EnabledFeatures & ~(UINT64)3;
+#ifdef __APPLE__
+    init_macos_legacy_gs();
+#endif
 
     /* sneak in a syscall dispatcher pointer at a fixed address (7ffe1000) */
     ptr = (char *)user_shared_data + page_size;
@@ -2914,6 +2937,15 @@
     sysarch( X86_64_SET_GSBASE, &teb );
 #elif defined (__APPLE__)
     thread_data->pthread_teb = mac_thread_gsbase();
+    init_macos_legacy_gs();
+    if (macos_legacy_gs)  /* D3DMetal bridge: Wine 11.0's macOS %gs model in D3DMetal processes (AnvilMac, patch 0009) */
+    {
+        /* %gs is the macOS TSD here; mirror the TEB fields PE code reads through %gs */
+        __asm__ volatile ("movq %0,%%gs:%c1" :: "r" (teb->Tib.Self), "n" (FIELD_OFFSET(TEB, Tib.Self)));
+        __asm__ volatile ("movq %0,%%gs:%c1" :: "r" (teb->ThreadLocalStoragePointer), "n" (FIELD_OFFSET(TEB, ThreadLocalStoragePointer)));
+        /* the PE loader updates the mirrored TLS pointer through this (alloc_tls_slot) */
+        teb->Instrumentation[0] = thread_data->pthread_teb;
+    }
 #else
 # error Please define setting %gs for your architecture
 #endif
@@ -3022,7 +3054,8 @@
  */
 __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
                    __ASM_LOCAL_LABEL("__wine_syscall_dispatcher_gs_load") ":\n\t"
-                   "movq %gs:0x378,%rcx\n\t"       /* thread_data->syscall_frame */

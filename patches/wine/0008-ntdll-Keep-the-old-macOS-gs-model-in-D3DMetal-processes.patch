                    "movq %rcx,%r10\n\t"
                    __ASM_LOCAL_LABEL("__wine_unix_call_dispatcher_gs_load") ":\n\t"
-                   "movq %gs:0x378,%rcx\n\t"       /* thread_data->syscall_frame */
+                   "movq %gs:0x30,%rcx\n\t"        /* D3DMetal bridge: Wine 11.0's macOS %gs model in D3DMetal processes (AnvilMac, patch 0009) */
+                   "movq 0x378(%rcx),%rcx\n\t"    /* thread_data->syscall_frame */
                    "popq 0x70(%rcx)\n\t"           /* frame->rip */
                    __ASM_CFI(".cfi_adjust_cfa_offset -8\n\t")
                    __ASM_CFI_REG_IS_AT2(rip, rcx, 0xf0,0x00)
@@ -3501,6 +3540,8 @@
 # endif
                    "1:\n\t"
 #elif defined __APPLE__
+                   "cmpb $0," __ASM_NAME("macos_legacy_gs") "(%rip)\n\t"
+                   "jnz 7f\n\t"
                    "movq %rax,%rdx\n\t"
                    "movq %rcx,%r14\n\t"
                    "movq %r13,%rdi\n\t"            /* teb */
@@ -3508,7 +3549,8 @@

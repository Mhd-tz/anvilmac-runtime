Subject: ntdll: Start i386 processes under x87sidecar when ROSETTA_X87_PATH is set, and hand over the task port.
Author: Alexander Theissen (x87sidecar cooperative handshake, athei/wine commit
f837e313f79eb721329314e371fd2bdc41f21186 "ntdll: HACK: Start i386 processes under the x87sidecar cooperatively",
2026-07-12, branch cx-26-patched); reduced and ported to Wine 11.19 by AnvilMac contributors (Claude Code), 2026-11-07.
Licence: LGPL-2.1-or-later, same as Wine. coop_proto.h is x87sidecar's wire protocol (x87sidecar is MIT,
github.com/athei/x87sidecar), identical to rosetta_loader/src/coop_proto.h at v1.9.1 apart from a note comment.
Provenance: https://github.com/athei/wine/commit/f837e313f79eb721329314e371fd2bdc41f21186. Applied after 0001-0017
to Wine 11.19, source tarball 73eb0b02dfc0cb0ff4f4d8d36c5786261e9725ac91968ae4d4e4b9a498c4087f. Not submitted upstream.

x87sidecar (bundled as bin/x87sidecar, built from v1.9.1) translates runs of x87 floating-point instructions as native
ARM64 instead of Rosetta 2's slow x87 path. With ROSETTA_X87_PATH set to an absolute path, Wine re-executes every
i386 process it creates as "x87sidecar --cooperative <loader> <args>"; the new process hands its task and thread
ports to the sidecar at the top of __wine_main (x87_cooperative_handshake) and waits until the hook is in place.
"wine game.exe" creates the game's i386 process this way, so setting the variable for a launch is enough. If the
sidecar can't hook (unsupported Rosetta), the process runs without it and prints "RUNNING WITHOUT X87 ACCELERATION".
Without ROSETTA_X87_PATH and X87_SIDECAR_BOOTSTRAP nothing changes.

Taken unchanged: coop_proto.h; x87_coop_unhooked() and x87_cooperative_handshake(). Not taken: CrossOver's
compatdb.so rules, the CrossOver loader handover, first-process target detection and the sidecar next to wine
(AnvilMac decides per game). Changed: the decision is made in the forked child from the image's PE machine
(exec_wineloader); a loader that doesn't exist (the alternate loader a WoW64 build lacks) is never handed over.

Tested 2026-11-06/07 on a local build of 11.19-14 plus this patch (AnvilMac harnesses): 32-bit x87 console probe,
20M iterations, 3 runs each: 22,061 ms -> 754 ms (29x), same checksum, fsin(1) 3feaed548f090cee -> ...cef (the
sidecar's binary64 result, proof of the hook); wrapping the first wine process instead gives no hook (4,437 ms).
Owner-played, Wine's fps trace, off vs on: Shank slowest 10 % 38 -> 57 fps; Max Payne median 35 -> 120 fps, slowest
10 % 15 -> 91; SPORE (30 fps cap) slowest 10 % 28.3 -> 29.8; no visual or sound problems.
---
diff --git a/dlls/ntdll/unix/coop_proto.h b/dlls/ntdll/unix/coop_proto.h
new file mode 100644
index 0000000..d75777e
--- /dev/null
+++ b/dlls/ntdll/unix/coop_proto.h
@@ -0,0 +1,62 @@
+#ifndef X87SIDECAR_COOP_PROTO_H
+#define X87SIDECAR_COOP_PROTO_H
+
+// Wire protocol for the cooperative task-port handshake between a tracee (a
+// binary built with the coop handshake shim, or wine with its handshake hook)
+// and the x87sidecar running in `--cooperative` mode.
+//
+// Rendezvous: the sidecar publishes a Mach receive port in the bootstrap
+// namespace under the name "x87sidecar.<tracee-pid>" (see X87_COOP_ENV). The
+// tracee looks it up and sends its own task + thread control ports, then blocks
+// for a reply. This replaces task_for_pid + ptrace(PT_ATTACHEXC), so the
+// sidecar binary needs no com.apple.security.get-task-allow and is notarizable.
+//
+// This header is plain C so the x86_64 test shim (and wine's unix loader) can
+// include it directly.
+//
+// NOTE: this is a VERBATIM copy of x87sidecar's
+// rosetta_loader/src/coop_proto.h. The two must stay byte-for-byte identical —
+// they define opposite ends of the same Mach wire protocol. Update both.
+
+#include <mach/mach.h>
+
+// Environment variable carrying the bootstrap service name to the tracee.
+// The sidecar sets it (via setenv) before forking so it survives the execv.
+#define X87_COOP_ENV "X87_SIDECAR_BOOTSTRAP"
+
+// msgh_id of the handshake request (tracee -> sidecar). The reply uses +1.
+#define X87_COOP_MSGH_ID 0x78383721 /* 'x87!' */
+
+// Request: tracee -> sidecar. Complex message with two port descriptors — the
+// tracee's task control port and the handshake thread's control port, both
+// COPY_SEND. msgh_local_port carries a MAKE_SEND_ONCE reply right that the
+// sidecar answers on to unblock the tracee.
+typedef struct {
+    mach_msg_header_t header;
+    mach_msg_body_t body;
+    mach_msg_port_descriptor_t task_port;
+    mach_msg_port_descriptor_t thread_port;
+} x87_coop_request_t;
+
+// Receive buffer on the sidecar side: request + room for the receive trailer.
+typedef struct {
+    x87_coop_request_t req;
+    mach_msg_trailer_t trailer;
+} x87_coop_request_rcv_t;
+
+// Reply: sidecar -> tracee. Its arrival unblocks the tracee. It also carries up
+// to two code ranges the sidecar patched (the translate_insn entry and the
+// injected handler) so the tracee can invalidate its OWN instruction cache for
+// them. This is required in cooperative mode: unlike the default attach (which
+// patches translate_insn before it has ever executed), the cooperative attach
+// happens post-Rosetta-init, when translate_insn is already hot in the i-cache
+// — and a cross-process mach_vm_machine_attribute flush does not reliably make
+// the patch visible. sys_icache_invalidate() on the tracee's own thread (IC
+// IVAU, broadcast inner-shareable) does. len == 0 means "unused slot".
+typedef struct {
+    mach_msg_header_t header;
+    uint64_t icache_addr[2];
+    uint64_t icache_len[2];
+} x87_coop_reply_t;
+
+#endif  // X87SIDECAR_COOP_PROTO_H
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 9da206d..94a4914 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -69,6 +69,9 @@
 # include <mach/mach.h>
 # include <mach/mach_error.h>
 # include <mach-o/getsect.h>
+# include <servers/bootstrap.h>
+# include <libkern/OSCacheControl.h>
+# include "coop_proto.h"
 # include <crt_externs.h>
 # ifndef _POSIX_SPAWN_DISABLE_ASLR
 #  define _POSIX_SPAWN_DISABLE_ASLR 0x0100
@@ -440,8 +443,47 @@ char *get_alternate_wineloader( WORD machine )
 }
 
 
-static void preloader_exec( char **argv )
+/* AnvilMac: the x87sidecar that i386 processes are started under, from ROSETTA_X87_PATH; none when it is
+ * unset or not an absolute path. "wine game.exe" creates the game's i386 process through exec_wineloader, so
+ * setting the variable for a launch is enough; every i386 process Wine creates then starts under the sidecar. */
+static const char *get_x87_sidecar_path(void)
 {
+#if defined(__APPLE__) && defined(__x86_64__)
+    const char *path = getenv( "ROSETTA_X87_PATH" );
+    return path && *path == '/' ? path : NULL;
+#else
+    return NULL;
+#endif
+}
+
+static void preloader_exec( char **argv, int x87 )
+{
+    const char *sidecar;
+
+    /* Re-exec an i386 process through "x87sidecar --cooperative <loader> <args>"; the sidecar starts the
+     * loader as its child, which hands over its task port in x87_cooperative_handshake(). Only for a loader
+     * that exists: loader_exec first tries an alternate loader that a WoW64 build doesn't have. */
+    if (x87 && (sidecar = get_x87_sidecar_path()) && !access( argv[1], X_OK ))
+    {
+        static char coop_flag[] = "--cooperative";
+        char **coop_argv;
+        int i, n;
+
+        for (n = 1; argv[n]; n++) {}
+        if ((coop_argv = malloc( (n + 2) * sizeof(*coop_argv) )))
+        {
+            coop_argv[0] = (char *)sidecar;
+            coop_argv[1] = coop_flag;
+            for (i = 1; i <= n; i++) coop_argv[i + 1] = argv[i];  /* argv[1..] and the NULL terminator */
+            fprintf( stderr, "wine: starting i386 process %s under x87sidecar %s\n",
+                     argv[2] ? argv[2] : "(none)", sidecar );
+            execv( coop_argv[0], coop_argv );
+            fprintf( stderr, "wine: could not start x87sidecar %s (errno %d), running without it\n",
+                     sidecar, errno );
+            free( coop_argv );
+        }
+    }
+
 #ifdef HAVE_WINE_PRELOADER
     asprintf( &argv[0], "%s-preloader", argv[1] );
 #ifdef __APPLE__
@@ -460,16 +502,16 @@ static void preloader_exec( char **argv )
 }
 
 /* exec the appropriate wine loader for the specified machine */
-static NTSTATUS loader_exec( char **argv, WORD machine )
+static NTSTATUS loader_exec( char **argv, WORD machine, int x87 )
 {
     static char noexec[] = "WINELOADERNOEXEC=1";
 
     putenv( noexec );
 
-    if (((argv[1] = get_alternate_wineloader( machine )))) preloader_exec( argv );
+    if (((argv[1] = get_alternate_wineloader( machine )))) preloader_exec( argv, x87 );
 
     argv[1] = strdup( wineloader );
-    preloader_exec( argv );
+    preloader_exec( argv, x87 );
     return STATUS_INVALID_IMAGE_FORMAT;
 }
 
@@ -499,7 +541,7 @@ NTSTATUS exec_wineloader( char **argv, int socketfd, const struct pe_image_info
     putenv( preloader_reserve );
     putenv( socket_env );
 
-    return loader_exec( argv, machine );
+    return loader_exec( argv, machine, machine == IMAGE_FILE_MACHINE_I386 );
 }
 
 
@@ -2035,7 +2077,7 @@ static void reexec_loader( int argc, char *argv[], char *extra_arg )
     /* default to 32-bit loader to support 32-bit prefixes */
     if (machine == IMAGE_FILE_MACHINE_AMD64) machine = IMAGE_FILE_MACHINE_I386;
 
-    loader_exec( new_argv, machine );
+    loader_exec( new_argv, machine, 0 );
     fatal_error( "could not exec the wine loader\n" );
 }
 
@@ -2097,6 +2139,145 @@ static void check_command_line( int argc, char *argv[] )
 }
 
 
+#ifdef __APPLE__
+/* HACK: tell the user that the x87sidecar did not install its hook. This is
+ * printed unconditionally, so that it shows even with WINEDEBUG=-all. The
+ * sidecar prints a banner with the same "RUNNING WITHOUT X87 ACCELERATION" text
+ * when it gives up on its own side. */
+static void x87_coop_unhooked( const char *reason )
+{
+    fprintf( stderr,
+             "################################################################\n"
+             "WARNING: X87SIDECAR DID NOT FINISH (%s).\n"
+             "THIS PROCESS IS RUNNING WITHOUT X87 ACCELERATION.\n"
+             "32-BIT GAMES THAT USE X87 MATH WILL BE MUCH SLOWER.\n"
+             "################################################################\n",
+             reason );
+}
+
+/***********************************************************************
+ *           x87_cooperative_handshake
+ *
+ * HACK: tracee side of the cooperative x87sidecar attach.
+ *
+ * When wine has re-exec'd itself through `x87sidecar --cooperative` (see
+ * preloader_exec), the sidecar publishes a Mach
+ * receive port in the bootstrap namespace under the name in X87_SIDECAR_BOOTSTRAP
+ * ("x87sidecar.<pid>"). This runs in the Rosetta-translated tracee: look the
+ * service up, hand over our task + main-thread control ports, and block until
+ * the sidecar has installed its x87 JIT hook and replies. The reply carries the
+ * code ranges the sidecar patched so we invalidate our OWN instruction cache for
+ * them: a cross-process flush is not reliable once translate_insn is already
+ * hot. This replaces task_for_pid + ptrace, so the sidecar needs no
+ * com.apple.security.get-task-allow entitlement and the bundle stays notarizable.
+ *
+ * A no-op unless X87_SIDECAR_BOOTSTRAP is set and names THIS pid, so it is inert
+ * in the ordinary (non-cooperative) loader and in unrelated wine processes that
+ * merely inherited the env var. Mirrors x87sidecar tests/coop_handshake.c.
+ */
+static void x87_cooperative_handshake(void)
+{
+    char *name = getenv( X87_COOP_ENV );
+    mach_port_t bootstrap_port = MACH_PORT_NULL;
+    mach_port_t service = MACH_PORT_NULL;
+    mach_port_t reply = MACH_PORT_NULL;
+    x87_coop_request_t msg;
+    struct {
+        x87_coop_reply_t reply;
+        mach_msg_trailer_t trailer;
+        char slack[64];
+    } rep;
+    kern_return_t kr;
+    char reason[64] = "";
+    char *dot;
+    int i;
+
+    if (!name || !*name) return;  /* not running under --cooperative */
+
+    /* Staleness guard: the service name embeds the intended tracee pid. A
+     * process that merely inherited the env var (the host loader, wineserver,
+     * an unrelated child) must not hand over its own task port. */
+    dot = strrchr( name, '.' );
+    if (!dot || atoi( dot + 1 ) != (int)getpid()) return;
+
+    if ((kr = task_get_bootstrap_port( mach_task_self(), &bootstrap_port )) != KERN_SUCCESS)
+    {
+        snprintf( reason, sizeof(reason), "NO BOOTSTRAP PORT, ERROR 0X%X", kr );
+        goto done;
+    }
+    kr = bootstrap_look_up( bootstrap_port, name, &service );
+    if (kr != KERN_SUCCESS)
+    {
+        snprintf( reason, sizeof(reason), "SIDECAR SERVICE NOT FOUND, ERROR 0X%X", kr );
+        goto done;
+    }
+
+    /* Reply port we block on until the sidecar has finished its setup. */
+    mach_port_allocate( mach_task_self(), MACH_PORT_RIGHT_RECEIVE, &reply );
+
+    memset( &msg, 0, sizeof(msg) );
+    msg.header.msgh_bits = MACH_MSGH_BITS( MACH_MSG_TYPE_COPY_SEND, MACH_MSG_TYPE_MAKE_SEND_ONCE ) |
+                           MACH_MSGH_BITS_COMPLEX;
+    msg.header.msgh_size = sizeof(msg);
+    msg.header.msgh_remote_port = service;  /* destination: sidecar */
+    msg.header.msgh_local_port = reply;     /* reply right -> send-once to sidecar */
+    msg.header.msgh_id = X87_COOP_MSGH_ID;
+    msg.body.msgh_descriptor_count = 2;
+    msg.task_port.name = mach_task_self();
+    msg.task_port.disposition = MACH_MSG_TYPE_COPY_SEND;
+    msg.task_port.type = MACH_MSG_PORT_DESCRIPTOR;
+    msg.thread_port.name = mach_thread_self();
+    msg.thread_port.disposition = MACH_MSG_TYPE_COPY_SEND;
+    msg.thread_port.type = MACH_MSG_PORT_DESCRIPTOR;
+
+    kr = mach_msg( &msg.header, MACH_SEND_MSG, sizeof(msg), 0, MACH_PORT_NULL,
+                   MACH_MSG_TIMEOUT_NONE, MACH_PORT_NULL );
+    if (kr != KERN_SUCCESS)
+    {
+        snprintf( reason, sizeof(reason), "HANDSHAKE SEND FAILED, ERROR 0X%X", kr );
+        goto done;
+    }
+
+    /* Block until the sidecar has done its install and replies. The receive
+     * buffer needs room for the header AND the kernel-appended trailer. If the
+     * sidecar exits without replying, the kernel sends a MACH_NOTIFY_SEND_ONCE
+     * notification to the reply port instead, which has a different id and
+     * size. */
+    memset( &rep, 0, sizeof(rep) );
+    kr = mach_msg( &rep.reply.header, MACH_RCV_MSG, 0, sizeof(rep), reply,
+                   MACH_MSG_TIMEOUT_NONE, MACH_PORT_NULL );
+
+    if (kr != KERN_SUCCESS)
+        snprintf( reason, sizeof(reason), "RECEIVE FAILED, ERROR 0X%X", kr );
+    else if (rep.reply.header.msgh_id == MACH_NOTIFY_SEND_ONCE)
+        snprintf( reason, sizeof(reason), "THE SIDECAR EXITED WITHOUT REPLYING" );
+    else if (rep.reply.header.msgh_id != X87_COOP_MSGH_ID + 1 ||
+             rep.reply.header.msgh_size != sizeof(rep.reply))
+        snprintf( reason, sizeof(reason), "UNEXPECTED REPLY, ID 0X%X SIZE %u",
+                  rep.reply.header.msgh_id, rep.reply.header.msgh_size );
+    else
+    {
+        /* Invalidate our own i-cache for the code the sidecar patched. This runs
+         * on the same thread that will execute translate_insn, and
+         * sys_icache_invalidate issues a broadcast (inner-shareable) IC IVAU,
+         * which a cross-process flush from the sidecar does not reliably
+         * achieve once translate_insn is hot. */
+        for (i = 0; i < 2; i++)
+            if (rep.reply.icache_len[i] != 0)
+                sys_icache_invalidate( (void *)(uintptr_t)rep.reply.icache_addr[i],
+                                       (size_t)rep.reply.icache_len[i] );
+    }
+
+done:
+    /* Destroy the reply port, so that a late reply finds no receiver. */
+    if (reply != MACH_PORT_NULL) mach_port_mod_refs( mach_task_self(), reply, MACH_PORT_RIGHT_RECEIVE, -1 );
+    if (service != MACH_PORT_NULL) mach_port_deallocate( mach_task_self(), service );
+    if (reason[0]) x87_coop_unhooked( reason );
+    unsetenv( X87_COOP_ENV );
+}
+#endif
+
+
 /***********************************************************************
  *           __wine_main
  *
@@ -2107,6 +2288,11 @@ DECLSPEC_EXPORT void __wine_main( int argc, char *argv[] )
     main_argc = argc;
     main_argv = argv;
 
+#ifdef __APPLE__
+    /* started under "x87sidecar --cooperative": hand over our task port and wait for its x87 hook */
+    x87_cooperative_handshake();
+#endif
+
     init_paths();
     if (!getenv( "WINELOADERNOEXEC" ) || argc <= 1) check_command_line( argc, argv );
     unsetenv( "WINELOADERNOEXEC" );

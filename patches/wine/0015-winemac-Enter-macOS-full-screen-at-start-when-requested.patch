+
+/* AppKit reported the app (re)activated: on macOS 27 a click in a macOS full-screen game did that on every press while
+   the game stayed frontmost (owner, Warcraft III, 2026-11-01, +event trace), and each time the system arrow appeared
+   over the game's own cursor and the pointer confinement stopped working. Set both again, including on the next move. */
+static BOOL reassertCursorOnNextMove;
+
+/* WINEMAC_NATIVE_FULLSCREEN: AppKit shows its arrow on mouse presses in a macOS full-screen game without telling us,
+   also on right presses that cause no activation (owner, Warcraft III, 2026-11-02: the game re-sent its unchanged
+   cursor, so Wine did nothing). After every button press and release, the client's cursor is set again. */
+static BOOL key_window_in_native_fullscreen(void)
+{
+    NSWindow* window = [NSApp keyWindow];
+    return enter_native_fullscreen && [window isKindOfClass:[WineWindow class]] &&
+           ([window styleMask] & NSWindowStyleMaskFullScreen);
+}
+
+/* The Dock appeared at the bottom edge of a macOS full-screen game after activations (owner, 2026-11-02) although
+   window:willUseFullScreenPresentationOptions: hid it on entering: keep it and the menu bar hidden for the app. Even
+   with the options already right, the Dock still showed until the first click (activation hand-over at start), so the
+   options are set again through an auto-hide step, which makes AppKit send them to the window server. */
+static void keep_dock_and_menu_bar_hidden(void)
+{
+    NSApplicationPresentationOptions current = [NSApp presentationOptions], wanted, step;
+    const NSApplicationPresentationOptions autoHide = NSApplicationPresentationAutoHideDock |
+                                                      NSApplicationPresentationAutoHideMenuBar |
+                                                      NSApplicationPresentationAutoHideToolbar;
+    const NSApplicationPresentationOptions hide = NSApplicationPresentationHideDock | NSApplicationPresentationHideMenuBar;
 
+    wanted = (current & ~autoHide) | hide;
+    step = (current & ~(autoHide | hide)) | NSApplicationPresentationAutoHideDock | NSApplicationPresentationAutoHideMenuBar;
+    TRACE_(nativefs)("native full screen presentation options 0x%lx -> 0x%lx (via 0x%lx)\n", (unsigned long)current,
+                     (unsigned long)wanted, (unsigned long)step);
+    @try
+    {
+        if (wanted == current)
+            [NSApp setPresentationOptions:step];
+        [NSApp setPresentationOptions:wanted];
+    }
+    @catch (NSException* e)
+    {
+        TRACE_(nativefs)("presentation options refused: %s\n", [[e reason] UTF8String]);
+    }
+}
 

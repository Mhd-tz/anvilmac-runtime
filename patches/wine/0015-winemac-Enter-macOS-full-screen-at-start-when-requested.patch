+    /* With WINEMAC_NATIVE_FULLSCREEN, macOS full screen keeps the menu bar and Dock hidden instead of revealing them
+       (with the title bar) when the pointer reaches the top or bottom edge, where games scroll their view. */
+    - (NSApplicationPresentationOptions) window:(NSWindow*)window willUseFullScreenPresentationOptions:(NSApplicationPresentationOptions)proposedOptions
+    {
+        if (!enter_native_fullscreen)
+            return proposedOptions;
+        return (proposedOptions & ~(NSApplicationPresentationAutoHideDock | NSApplicationPresentationAutoHideMenuBar |
+                                    NSApplicationPresentationAutoHideToolbar)) |
+               NSApplicationPresentationFullScreen | NSApplicationPresentationHideDock | NSApplicationPresentationHideMenuBar;
+    }
+
+    /* With WINEMAC_NATIVE_FULLSCREEN, a window in macOS full screen keeps the pointer inside its content, as ClipCursor
+       to the client area would: the strip beside the camera housing above it is outside the window, so the pointer
+       would leave the game exactly where it scrolls its view. macOS applies a confinement only while the app is
+       frontmost and the window is key. A clip the client sets itself (ClipCursor) takes precedence and replaces this
+       until it is released (-[WineApplicationController stopClippingCursor] calls this again). */
+    - (void) updateNativeFullscreenConfinement
+    {
+        WineApplicationController* controller = [WineApplicationController sharedController];
+        BOOL confine;
+
+        NSRect rect;
+
+        if (!enter_native_fullscreen || ![self respondsToSelector:@selector(setMouseConfinementRect:)])
+            return;
+        if (controller.clippingCursor)
+        {
+            /* The client's clip replaced ours; apply ours again from scratch once it is released. */
+            native_fullscreen_confined_window = 0;
+            return;
+        }
+        confine = ([self styleMask] & NSWindowStyleMaskFullScreen) && !exitingFullScreen && [self isVisible];
+        /* What is visible of the window: its frame within its screen, below the screen's top safe area (the strip
+           beside the camera housing), in window coordinates. Not the content view's frame, which can lag behind or
+           differ (owner, 2026-11-02: confinement 1720 x 962 of a 1728 x 1084 window). */
+        rect = NSZeroRect;
+        if (confine && [self screen])
+        {
+            NSRect visible = [[self screen] frame];
+            if (@available(macOS 12.0, *))
+                visible.size.height -= [[self screen] safeAreaInsets].top;
+            visible = NSIntersectionRect([self frame], visible);
+            if (NSIsEmptyRect(visible))
+                confine = FALSE;
+            else
+                rect = [self convertRectFromScreen:visible];
         }
+        else
+            confine = FALSE;
+        if (confine && native_fullscreen_confined_window == [self windowNumber] &&
+            NSEqualRects(rect, native_fullscreen_confined_rect))
+            return;
+        if (!confine && native_fullscreen_confined_window != [self windowNumber])
+            return;
+        TRACE_(nativefs)("native full screen confinement %g,%g %gx%g (window frame %g,%g %gx%g, content view %gx%g, key %d active %d)\n",
+                       NSMinX(rect), NSMinY(rect), NSWidth(rect), NSHeight(rect), NSMinX([self frame]), NSMinY([self frame]), NSWidth([self frame]),
+                       NSHeight([self frame]), NSWidth([[self contentView] frame]), NSHeight([[self contentView] frame]),
+                       [self isKeyWindow], [NSApp isActive]);
+        [self setMouseConfinementRect:rect];
+        native_fullscreen_confined_window = confine ? [self windowNumber] : 0;
+        native_fullscreen_confined_rect = rect;
+        [controller reassertClientCursor];
+    }
+
+    /* After the app (re)activates, macOS may have dropped the confinement: set it again even if unchanged. */
+    - (void) reapplyNativeFullscreenConfinement
+    {
+        if (native_fullscreen_confined_window == [self windowNumber])
+            native_fullscreen_confined_window = 0;
+        [self updateNativeFullscreenConfinement];
     }
 

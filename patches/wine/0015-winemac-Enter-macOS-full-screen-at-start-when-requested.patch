+/* Automatic macOS full screen (AnvilMac, WINEMAC_NATIVE_FULLSCREEN): once per process, the first window that is
+   eligible for the green window button and keeps its frame for a second is put into full screen, exactly as that
+   button does. Every show or frame change of an eligible window restarts the second, so splash windows and the
+   game's own early resizes pass first. Never repeated, so a player who leaves full screen stays out. */
+static BOOL native_fullscreen_done;
+static NSUInteger native_fullscreen_generation;
+
+/* Games resize their own window when they apply a resolution. In full screen started this way the window keeps filling
+   the screen and the game is told so; these bound that, so a game that insists is let through (5 refusals a second). */
+static NSTimeInterval native_fullscreen_refusals_since;
+static unsigned int native_fullscreen_refusals;
+
+/* The confinement last applied by updateNativeFullscreenConfinement (window number 0: none). Wine reorders and refocuses
+   windows on clicks; setting the same confinement again each time made the system arrow appear over a game's own
+   cursor (owner, Warcraft III, 2026-11-01), so it is only set when it changes. */
+static NSInteger native_fullscreen_confined_window;
+static NSRect native_fullscreen_confined_rect;
+
+/* -[NSWindow setMouseConfinementRect:], as cocoa_cursorclipping.m uses it for ClipCursor (macOS 10.13+). */
+@interface NSWindow (WineNativeFullscreenConfinement)
+    - (void) setMouseConfinementRect:(NSRect)mouseConfinementRect;
+@end

+    /* WINEMAC_NATIVE_FULLSCREEN: while this window is in macOS full screen (not entering or leaving it), a frame the
+       client sets (a game applying its resolution, often with window borders) isn't applied: the window would shrink
+       inside the full-screen space, with black around it and the pointer able to leave it. The requested frame is kept
+       for leaving full screen, and the client is told the window still fills the screen, as when it entered. */
+    - (BOOL) keepsNativeFullscreenFrameAgainst:(NSRect)contentRect
+    {
+        NSTimeInterval now = [[NSProcessInfo processInfo] systemUptime];
+
+        /* Also while entering: a game applying its resolution during macOS's transition otherwise kept that size once
+           in full screen (owner, 2026-11-02: bottom and right edges unreachable again in an untraced session). */
+        if (!enter_native_fullscreen || !(([self styleMask] & NSWindowStyleMaskFullScreen) || enteringFullScreen) ||
+            exitingFullScreen)
+            return FALSE;
+        if (NSEqualSizes(contentRect.size, [self contentRectForFrameRect:self.wine_fractionalFrame].size))
+            return FALSE;
+        TRACE_(nativefs)("client frame %gx%g requested in full screen (entering %d); window %gx%g\n", contentRect.size.width,
+                         contentRect.size.height, enteringFullScreen, NSWidth(self.wine_fractionalFrame),
+                         NSHeight(self.wine_fractionalFrame));
+        if (now - native_fullscreen_refusals_since > 1.0)
+        {
+            native_fullscreen_refusals_since = now;
+            native_fullscreen_refusals = 0;
+        }
+        if (++native_fullscreen_refusals > 5)
+        {
+            TRACE_(nativefs)("more than 5 requests in a second: applied\n");
+            return FALSE;
+        }
+        nonFullscreenFrame = [NSWindow frameRectForContentRect:contentRect
+                                                     styleMask:[self styleMask] & ~NSWindowStyleMaskFullScreen];
+        TRACE_(nativefs)("native full screen keeps its frame instead of the client's %gx%g\n", contentRect.size.width, contentRect.size.height);
+        TRACE("window %p keeps its full-screen frame instead of %gx%g\n", self.hwnd, contentRect.size.width, contentRect.size.height);
+        [self windowDidResize:nil skipSizeMove:TRUE];
+        return TRUE;
     }
 
+    /* Eligible: an ordinary visible top-level window the green button can put in full screen (Wine gives it
+       NSWindowCollectionBehaviorFullScreenPrimary only when resizable, cycled, unparented and not maximized), at
+       least 640 x 400, not already covering a screen on its own and not in or between full-screen transitions. */
+    - (BOOL) eligibleForNativeFullscreenAtStart
+    {
+        NSSize size = [self contentRectForFrameRect:[self frame]].size;
+
+        return [self isVisible] && [self isOnActiveSpace] && ![self isMiniaturized] && !self.disabled && !maximized &&
+               !fullscreen && !enteringFullScreen && !exitingFullScreen &&
+               !([self styleMask] & NSWindowStyleMaskFullScreen) &&
+               ([self collectionBehavior] & NSWindowCollectionBehaviorFullScreenPrimary) &&
+               size.width >= 640 && size.height >= 400;
+    }
+
+    - (void) scheduleNativeFullscreenAtStart
+    {
+        NSUInteger generation;
+
+        if (!enter_native_fullscreen || native_fullscreen_done || ![self eligibleForNativeFullscreenAtStart])
+            return;
+        generation = ++native_fullscreen_generation;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+            if (generation != native_fullscreen_generation || native_fullscreen_done ||
+                ![self eligibleForNativeFullscreenAtStart])
+                return;
+            native_fullscreen_done = TRUE;
+            TRACE_(nativefs)("entering macOS full screen, window %gx%g\n", NSWidth([self frame]), NSHeight([self frame]));
+            TRACE("entering macOS full screen for window %p (WINEMAC_NATIVE_FULLSCREEN)\n", self.hwnd);
+            [self toggleFullScreen:nil];
+        });
+    }

+  /* AnvilMac: called after each present, on DXMT's encoding thread (see WineFpsChannel). */
+  void ReportFrameRate() {
+    auto &wine = WineFpsChannel::get();
+    if (!wine.enabled)
+      return;
+    LARGE_INTEGER now, frequency;
+    QueryPerformanceCounter(&now);
+    if (!fps_since_.QuadPart) {
+      fps_since_ = now;
+      fps_frames_ = 0;
+      return;
+    }
+    ++fps_frames_;
+    QueryPerformanceFrequency(&frequency);
+    double elapsed = double(now.QuadPart - fps_since_.QuadPart) / double(frequency.QuadPart);
+    if (elapsed < 1.5)
+      return;
+    wine.report(this, fps_frames_ / elapsed);
+    fps_since_ = now;
+    fps_frames_ = 0;
+  }
+
   void UpdateStatistics(const FrameStatisticsContainer& statistics, uint64_t frame_id) {
     hud.begin();
     auto &frame = statistics.at(frame_id - 1); // show the previous one frame statistics
@@ -1093,6 +1158,8 @@ private:
